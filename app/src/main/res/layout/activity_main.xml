<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scythe_bg">

    <!-- Globe home surface: CesiumJS 3D globe (vendored, offline) -->
    <WebView
        android:id="@+id/globeView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black" />

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:background="#E61a2035"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/connecting"
            android:textColor="@color/scythe_accent"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:ellipsize="end"/>

        <ImageButton
            android:id="@+id/btnConsole"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_view"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/scythe_accent"
            android:contentDescription="Console"/>

        <ImageButton
            android:id="@+id/btnTwin"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_camera"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/scythe_accent"
            android:contentDescription="AR Twin"/>

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_preferences"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/scythe_accent"
            android:contentDescription="@string/settings"/>
    </LinearLayout>

    <!-- Mode banner: SAFARI green / OPERATOR amber. Tappable. -->
    <TextView
        android:id="@+id/modeBanner"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:layout_gravity="top"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:text="● OPERATOR"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:background="#8a5a00"
        android:textColor="#ffe0b0"/>

    <!-- Layer rail: right edge -->
    <LinearLayout
        android:id="@+id/layerRail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right|center_vertical"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/btnLayerRf"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:text="RF"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:background="#1a2035"
            android:textColor="#00d4ff"/>

        <TextView
            android:id="@+id/btnLayerAir"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:text="AIR"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:background="#1a2035"
            android:textColor="#00d4ff"/>

        <TextView
            android:id="@+id/btnLayerSpace"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:text="SPC"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:background="#1a2035"
            android:textColor="#00d4ff"/>

        <TextView
            android:id="@+id/btnLayerSea"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:text="SEA"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:background="#1a2035"
            android:textColor="#00d4ff"/>

        <TextView
            android:id="@+id/btnLayerCov"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="COV"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:background="#1a2035"
            android:textColor="#00d4ff"/>
    </LinearLayout>

    <!-- Bottom status strips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/sensorBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#E61a2035"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSensorStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/sensor_active"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:singleLine="true"/>

                <TextView
                    android:id="@+id/tvSensorMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/scythe_accent"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:maxLines="2"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvSensorStop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="■ stop"
                android:textColor="@color/status_disconnected"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sdrBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#E61a2035"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSdrStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/sensor_active"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:singleLine="true"/>

                <TextView
                    android:id="@+id/tvSdrMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/scythe_accent"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:maxLines="2"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvSdrStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶ start"
                android:textColor="@color/sensor_active"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"/>

            <TextView
                android:id="@+id/tvSdrStop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="■ stop"
                android:textColor="@color/status_disconnected"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
